[Unit]
Description=PlanFix remaining TourAPI details (2026-09-20 through 2026-09-23)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=oneshot
User=planfix-spot-backfill
Group=planfix-spot-backfill
StateDirectory=planfix-spot-backfill
StateDirectoryMode=0750
LoadCredential=credentials.json:/etc/planfix-spot-backfill/credentials.json
ExecStart=/opt/planfix-spot-backfill/venv/bin/python /opt/planfix-spot-backfill/backfill.py run
TimeoutStartSec=2h
Restart=on-failure
RestartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
MemoryMax=256M
CPUQuota=25%
Nice=10
