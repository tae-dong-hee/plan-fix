# Copy to .env.recovery (git-ignored), chmod 600, and fill privately.
# These values must be injected as environment variables; Spring does not read this file automatically.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_FROM=
FRONTEND_BASE_URL=https://planfix.cloud
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true

SMS_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SMS_FROM=

# Controlled recipients for actual receipt and recovery verification.
TEST_EMAIL=
TEST_PHONE=
