# Backend API root. Do not place secrets in VITE_* variables (they are exposed to the client).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 카카오맵 JavaScript 키. 카카오 개발자 콘솔 > 앱 > 플랫폼 키에서 확인한다.
# 브라우저에 공개되는 키이며, 해당 키의 JavaScript SDK 도메인에 개발·운영 주소를 각각 등록해야 한다.
# 앱에서 카카오맵 서비스를 활성화하고, 실제 접속 주소의 프로토콜과 포트까지 일치시킨다.
# Docker 빌드는 .env.local을 읽지 않으므로 --build-arg VITE_KAKAO_JS_KEY로 전달한다.
# 키가 없거나 공백이면 Docker 빌드를 중단한다. 컨테이너 실행 시 환경변수만 넣어서는 반영되지 않는다.
VITE_KAKAO_JS_KEY=
