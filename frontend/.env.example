# Backend API root. Do not place secrets in VITE_* variables (they are exposed to the client).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 카카오맵·카카오톡 공유에서 함께 쓰는 JavaScript 키. 카카오 개발자 콘솔 > 앱 > 플랫폼 키에서 확인한다.
# 브라우저에 공개되는 키이며, 해당 키의 JavaScript SDK 도메인에 개발·운영 주소를 각각 등록해야 한다.
# 앱에서 카카오맵 서비스를 활성화하고, 실제 접속 주소의 프로토콜과 포트까지 일치시킨다.
# 카카오톡 공유: 제품 링크 관리 > 웹 도메인에도 초대 링크의 주소(예: https://planfix.cloud)를 등록한다.
# Docker 빌드는 .env.local을 읽지 않으므로 --build-arg VITE_KAKAO_JS_KEY로 전달한다.
# 키가 없거나 공백이면 Docker 빌드를 중단한다. 컨테이너 실행 시 환경변수만 넣어서는 반영되지 않는다.
VITE_KAKAO_JS_KEY=

# 선택: 승인된 사진 없는 장소 상세의 Google Places UI Kit 카드.
# 브라우저 공개 키이며 HTTP referrer 및 Maps JavaScript API / Places UI Kit API 제한을 설정한다.
# 키가 없으면 기존 장소 사진 안내를 유지한다. Google 사진 URL은 DB에 저장하지 않는다.
VITE_GOOGLE_MAPS_API_KEY=
